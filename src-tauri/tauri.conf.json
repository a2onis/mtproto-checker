{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MTProto Checker",
  "version": "0.2.0",
  "identifier": "com.a2onis.mtproto-checker",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MTProto Checker",
        "width": 1240,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
