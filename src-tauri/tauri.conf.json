{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MTProto Checker",
  "version": "0.1.0",
  "identifier": "com.a2onis.mtproto-checker",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "title": "MTProto Checker",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
